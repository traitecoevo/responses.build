# This file is generated by responses.build's `build_setup_pipeline()`.
# Regenerate it rather than editing it.
#
# Unlike the remake pipeline it replaces, this does not name each dataset as
# three hand-written targets. `tar_map()` branches over the list below, so
# adding a dataset means adding a folder -- nothing here changes, and the
# pipeline cannot drift out of step with `data/` the way a generated file with
# one target per dataset did.

library(targets)
library(tarchetypes)

tar_option_set(
  packages = "responses.build",
  format = "rds"
)

# Datasets are read from disk at pipeline-construction time, so a new folder is
# picked up on the next `tar_make()` without regenerating this file. It is
# still written out below, so the pipeline is reproducible from the file alone.
DATASETS <- {{dataset_ids_vector}}

dataset_targets <- tarchetypes::tar_map(
  values = list(dataset_id = DATASETS),
  names = dataset_id,

  tar_target(
    metadata_file,
    file.path("{{path}}", dataset_id, "metadata.yml"),
    format = "file"
  ),
  tar_target(
    data_file,
    file.path("{{path}}", dataset_id, "data.csv"),
    format = "file"
  ),
  tar_target(
    config,
    dataset_configure(metadata_file, definitions, instruments, data_types)
  ),
  tar_target(
    raw,
    dataset_process(
      data_file, config, schema, resource_metadata, unit_conversions,
      data_types = data_types,
      vocabularies = vocabularies,
      growth_conditions_vocab = growth_conditions_vocab,
      provenance_properties = provenance_properties
    )
  ),
  tar_target(
    built,
    dataset_update_taxonomy(raw, taxon_list)
  )
)

list(

  # Compilation-level configuration. Declared as `format = "file"` so a change
  # to any of them invalidates every dataset that read it -- which a remake
  # pipeline naming them as plain commands did not do.
  tar_target(schema_file, get_schema_path(), format = "file"),
  tar_target(schema, get_schema(schema_file)),

  tar_target(metadata_file_cfg, "config/metadata.yml", format = "file"),
  tar_target(resource_metadata, get_schema(metadata_file_cfg, "metadata")),

  tar_target(definitions_file, get_definitions_path(), format = "file"),
  tar_target(definitions, get_definitions(definitions_file)),

  tar_target(data_types, get_data_types()),
  tar_target(vocabularies, get_vocabularies()),
  tar_target(growth_conditions_vocab, get_growth_conditions()),
  tar_target(provenance_properties, get_provenance_properties()),
  tar_target(instruments, get_instruments()),

  tar_target(unit_conversions_file, "config/unit_conversions.csv", format = "file"),
  tar_target(unit_conversions, get_unit_conversions(unit_conversions_file)),

  tar_target(taxon_list_file, "config/taxon_list.csv", format = "file"),
  tar_target(taxon_list, read_csv_char(taxon_list_file)),

  dataset_targets,

  # One database from all the datasets
  tarchetypes::tar_combine(
    {{database_name}}_raw,
    dataset_targets[["built"]],
    command = bind_databases(databases = list(!!!.x))
  ),

  tar_target(version_number, util_get_version("config/metadata.yml")),
  tar_target(git_SHA, util_get_SHA()),

  tar_target(
    {{database_name}},
    build_add_version({{database_name}}_raw, version_number, git_SHA)
  ),

  tar_target(
    {{database_name}}_rds,
    {
      dir.create("export/data/curr", recursive = TRUE, showWarnings = FALSE)
      path <- "export/data/curr/{{database_name}}.rds"
      saveRDS({{database_name}}, path)
      path
    },
    format = "file"
  )
)
